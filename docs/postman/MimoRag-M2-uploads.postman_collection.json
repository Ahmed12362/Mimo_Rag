{
  "info": {
    "name": "MimoRag — M2 document upload and extraction (slices 2b–2d)",
    "description": "Run the requests in order. Before you start, set the collection variable `adminKey` to your plaintext platform-admin key (its SHA-256 is MIMORAG_ADMIN_KEY_SHA256). Every request saves the ids it returns, so later requests just work. In '2. Upload a PDF', choose a PDF file in Body > form-data > file. After the job succeeds, '2.6'–'2.8' show the extracted pages (2.7 and 2.8 need DOCUMENT_REVIEW). OCR (slice 2d): when the PDF has scanned pages and the OCR service is enabled, '2.2' saves the OCR job id (nextJobId) and '2.9' follows it; '2.8' then also shows the page's OCR proposal in a separate 'ocr' object (reviewState UNREVIEWED; never part of 'text').",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminKey",
      "value": ""
    },
    {
      "key": "integrationId",
      "value": ""
    },
    {
      "key": "bootstrapKey",
      "value": ""
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "kbId",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "ocrJobId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Setup",
      "item": [
        {
          "name": "1.1 Register integration (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('integrationId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"hris-{{$randomInt}}\",\n  \"name\": \"HRIS (Postman)\",\n  \"allowedScopes\": [\"KB_READ\", \"KB_MANAGE\", \"DOCUMENT_UPLOAD\", \"DOCUMENT_REVIEW\"]\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/integrations"
          }
        },
        {
          "name": "1.2 Issue bootstrap key (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('bootstrapKey', pm.response.json().plaintextKey);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"postman handover\" }"
            },
            "url": "{{baseUrl}}/api/v1/admin/integrations/{{integrationId}}/bootstrap-keys"
          }
        },
        {
          "name": "1.3 Create the integration's own key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('apiKey', pm.response.json().plaintextKey);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{bootstrapKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"postman\",\n  \"scopes\": [\"KB_READ\", \"KB_MANAGE\", \"DOCUMENT_UPLOAD\", \"DOCUMENT_REVIEW\"]\n}"
            },
            "url": "{{baseUrl}}/api/v1/integration/api-keys"
          }
        },
        {
          "name": "1.4 Create knowledge base",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('kbId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"code\": \"policies-{{$randomInt}}\", \"name\": \"HR policies\" }"
            },
            "url": "{{baseUrl}}/api/v1/knowledge-bases"
          }
        }
      ]
    },
    {
      "name": "2. Documents",
      "item": [
        {
          "name": "2.1 Upload a PDF",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 Accepted (or 200 for a duplicate)', () => pm.expect(pm.response.code).to.be.oneOf([200, 202]));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('documentId', body.documentId);",
                  "pm.collectionVariables.set('jobId', body.jobId);",
                  "console.log('outcome', body.outcome, 'job', body.jobId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-{{$guid}}",
                "description": "Optional. Re-sending with the same key returns the same result."
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Choose a PDF (max 50 MB, 500 pages)"
                },
                {
                  "key": "title",
                  "type": "text",
                  "value": "HR Policies",
                  "description": "Optional; defaults to the file name"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/knowledge-bases/{{kbId}}/documents"
          }
        },
        {
          "name": "2.2 Job status (repeat until SUCCEEDED / FAILED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const job = pm.response.json();",
                  "console.log(job.status, job.errorCode, 'pages:', job.pageCount);",
                  "if (job.nextJobId) { pm.collectionVariables.set('ocrJobId', job.nextJobId); console.log('OCR job:', job.nextJobId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/ingestion-jobs/{{jobId}}"
          }
        },
        {
          "name": "2.3 Document with versions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}"
          }
        },
        {
          "name": "2.4 List documents of the knowledge base",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/knowledge-bases/{{kbId}}/documents?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "knowledge-bases",
                "{{kbId}}",
                "documents"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "2.5 Retry a failed or cancelled job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/ingestion-jobs/{{jobId}}/retry",
            "description": "202 when requeued (or already queued/running). 409 for a job that succeeded or failed permanently (e.g. PDF_ENCRYPTED)."
          }
        },
        {
          "name": "2.6 Extraction summary (progress and page counts)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const run = pm.response.json().run;",
                  "if (run) console.log(run.status, run.pagesDone + '/' + run.pagesTotal, 'native', run.pagesNative, 'ocr', run.pagesOcrRequired, 'mixed', run.pagesMixed);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}/extraction",
            "description": "DOCUMENT_UPLOAD or DOCUMENT_REVIEW. versionStatus EXTRACTED = all pages have text; AWAITING_OCR = some pages need OCR (slice 2d)."
          }
        },
        {
          "name": "2.7 Pages (class, scripts, warnings; no text)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/documents/{{documentId}}/pages?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "{{documentId}}",
                "pages"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "DOCUMENT_REVIEW. 403 for upload-only keys."
          }
        },
        {
          "name": "2.8 One page with its text",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "console.log(p.pageClass, p.scripts, p.warnings);",
                  "console.log(p.text);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}/pages/1",
            "description": "DOCUMENT_REVIEW. text is null when the page needs OCR or its native text is unreliable (never exposed). Change the page number in the URL."
          }
        },
        {
          "name": "2.9 OCR job status (repeat until SUCCEEDED / FAILED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const job = pm.response.json();",
                  "pm.test('OCR job', () => pm.expect(job.kind).to.eql('OCR_DOCUMENT'));",
                  "console.log(job.status, job.errorCode, 'version:', job.versionStatus, 'progress:', JSON.stringify(job.progress));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/ingestion-jobs/{{ocrJobId}}",
            "description": "Requires MIMORAG_OCR_ENABLED=true and the OCR service (docker compose --profile ocr up -d ocr). A failed OCR job can be retried with 2.5 using this id."
          }
        }
      ]
    },
    {
      "name": "3. Negative checks",
      "item": [
        {
          "name": "3.1 Upload something that is not a PDF (expect 415)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('415 Unsupported Media Type', () => pm.response.to.have.status(415));",
                  "pm.test('errorCode', () => pm.expect(pm.response.json().errorCode).to.eql('UNSUPPORTED_MEDIA_TYPE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Choose any non-PDF file, even one renamed to .pdf"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/knowledge-bases/{{kbId}}/documents"
          }
        },
        {
          "name": "3.2 Request without an API key (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/ingestion-jobs/{{jobId}}"
          }
        },
        {
          "name": "3.3 Unknown job id (expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/ingestion-jobs/00000000-0000-0000-0000-000000000000"
          }
        }
      ]
    }
  ]
}