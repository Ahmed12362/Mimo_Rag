{
  "info": {
    "name": "MimoRag — M2 document upload (slice 2b)",
    "description": "Run the requests in order. Before you start, set the collection variable `adminKey` to your plaintext platform-admin key (its SHA-256 is MIMORAG_ADMIN_KEY_SHA256). Every request saves the ids it returns, so later requests just work. In '2. Upload a PDF', choose a PDF file in Body > form-data > file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminKey", "value": "" },
    { "key": "integrationId", "value": "" },
    { "key": "bootstrapKey", "value": "" },
    { "key": "apiKey", "value": "" },
    { "key": "kbId", "value": "" },
    { "key": "documentId", "value": "" },
    { "key": "jobId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Setup",
      "item": [
        {
          "name": "1.1 Register integration (admin)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('integrationId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Admin-Key", "value": "{{adminKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"hris-{{$randomInt}}\",\n  \"name\": \"HRIS (Postman)\",\n  \"allowedScopes\": [\"KB_READ\", \"KB_MANAGE\", \"DOCUMENT_UPLOAD\", \"DOCUMENT_REVIEW\"]\n}" },
            "url": "{{baseUrl}}/api/v1/admin/integrations"
          }
        },
        {
          "name": "1.2 Issue bootstrap key (admin)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('bootstrapKey', pm.response.json().plaintextKey);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Admin-Key", "value": "{{adminKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{ \"name\": \"postman handover\" }" },
            "url": "{{baseUrl}}/api/v1/admin/integrations/{{integrationId}}/bootstrap-keys"
          }
        },
        {
          "name": "1.3 Create the integration's own key",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('apiKey', pm.response.json().plaintextKey);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Api-Key", "value": "{{bootstrapKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"postman\",\n  \"scopes\": [\"KB_READ\", \"KB_MANAGE\", \"DOCUMENT_UPLOAD\", \"DOCUMENT_REVIEW\"]\n}" },
            "url": "{{baseUrl}}/api/v1/integration/api-keys"
          }
        },
        {
          "name": "1.4 Create knowledge base",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('kbId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Api-Key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{ \"code\": \"policies-{{$randomInt}}\", \"name\": \"HR policies\" }" },
            "url": "{{baseUrl}}/api/v1/knowledge-bases"
          }
        }
      ]
    },
    {
      "name": "2. Documents",
      "item": [
        {
          "name": "2.1 Upload a PDF",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('202 Accepted (or 200 for a duplicate)', () => pm.expect(pm.response.code).to.be.oneOf([200, 202]));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('documentId', body.documentId);",
            "pm.collectionVariables.set('jobId', body.jobId);",
            "console.log('outcome', body.outcome, 'job', body.jobId);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Api-Key", "value": "{{apiKey}}" },
              { "key": "Idempotency-Key", "value": "postman-{{$guid}}", "description": "Optional. Re-sending with the same key returns the same result." }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [], "description": "Choose a PDF (max 50 MB, 500 pages)" },
                { "key": "title", "type": "text", "value": "HR Policies", "description": "Optional; defaults to the file name" }
              ]
            },
            "url": "{{baseUrl}}/api/v1/knowledge-bases/{{kbId}}/documents"
          }
        },
        {
          "name": "2.2 Job status (repeat until SUCCEEDED / FAILED)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const job = pm.response.json();",
            "console.log(job.status, job.errorCode, 'pages:', job.pageCount);"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/api/v1/ingestion-jobs/{{jobId}}"
          }
        },
        {
          "name": "2.3 Document with versions",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}"
          }
        },
        {
          "name": "2.4 List documents of the knowledge base",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/knowledge-bases/{{kbId}}/documents?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "knowledge-bases", "{{kbId}}", "documents"],
              "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }]
            }
          }
        },
        {
          "name": "2.5 Retry a failed or cancelled job",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/api/v1/ingestion-jobs/{{jobId}}/retry",
            "description": "202 when requeued (or already queued/running). 409 for a job that succeeded or failed permanently (e.g. PDF_ENCRYPTED)."
          }
        }
      ]
    },
    {
      "name": "3. Negative checks",
      "item": [
        {
          "name": "3.1 Upload something that is not a PDF (expect 415)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('415 Unsupported Media Type', () => pm.response.to.have.status(415));",
            "pm.test('errorCode', () => pm.expect(pm.response.json().errorCode).to.eql('UNSUPPORTED_MEDIA_TYPE'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": [], "description": "Choose any non-PDF file, even one renamed to .pdf" }]
            },
            "url": "{{baseUrl}}/api/v1/knowledge-bases/{{kbId}}/documents"
          }
        },
        {
          "name": "3.2 Request without an API key (expect 401)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/ingestion-jobs/{{jobId}}"
          }
        },
        {
          "name": "3.3 Unknown job id (expect 404)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/api/v1/ingestion-jobs/00000000-0000-0000-0000-000000000000"
          }
        }
      ]
    }
  ]
}
