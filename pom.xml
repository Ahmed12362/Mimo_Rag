<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.2.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.mimocodes</groupId>
	<artifactId>mimorag</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>MimoRag</name>
	<description>Generic, multi-tenant RAG platform for connected company systems</description>

	<properties>
		<java.version>21</java.version>
		<!-- Versions not managed by the Spring Boot BOM. Stable releases only (no -M / -RC). -->
		<springdoc.version>3.2.1</springdoc.version>
		<archunit.version>1.5.1</archunit.version>
		<pdfbox.version>3.0.7</pdfbox.version>
		<!-- Tests tagged ocr-it / ocr-bench need the real OCR service (and the 2a corpus): -Pocr-it, -Pocr-bench. -->
		<test.groups></test.groups>
		<test.excludedGroups>ocr-it,ocr-bench</test.excludedGroups>
	</properties>

	<dependencies>
		<!-- Web / API -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!-- Security (deny-by-default baseline; authentication arrives in M1) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- JWT/JWKS verification of signed user assertions; used only inside the `access` module (ArchUnit-enforced). -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-jose</artifactId>
		</dependency>

		<!-- PDF parsing; used only inside ingestion.infrastructure (ArchUnit-enforced). -->
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>${pdfbox.version}</version>
		</dependency>

		<!-- Operations -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Persistence -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Tests -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Stored originals are read-only by design; on Windows that attribute would otherwise block `mvn clean`
			     from removing the integration-test storage under target/. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<configuration>
					<force>true</force>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<groups>${test.groups}</groups>
					<excludedGroups>${test.excludedGroups}</excludedGroups>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Real OCR accuracy suite (docs/adr/0014-ocr-service.md): needs the OCR container on MIMORAG_OCR_BASE_URL,
		     MIMORAG_OCR_TOKEN, and the generated 2a corpus. Usage: ./mvnw test -Pocr-it -->
		<profile>
			<id>ocr-it</id>
			<properties>
				<test.groups>ocr-it</test.groups>
				<test.excludedGroups>ocr-bench</test.excludedGroups>
			</properties>
		</profile>
		<!-- OCR throughput / worker layout benchmark (docs/benchmarks/ocr-2d-results.md). Needs the OCR container;
		     see OcrThroughputBenchmarkTest for the -D options. Usage: ./mvnw test -Pocr-bench -->
		<profile>
			<id>ocr-bench</id>
			<properties>
				<test.groups>ocr-bench</test.groups>
				<test.excludedGroups>ocr-it</test.excludedGroups>
			</properties>
		</profile>
	</profiles>

</project>
