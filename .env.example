# Local development settings. Copy to `.env` (git-ignored) and replace every change-me value.
# These are placeholders, not real secrets. Never commit a populated .env file.
# Read by both `docker compose` and the Spring `local` profile.

# --- PostgreSQL container (docker-compose.yml) ---
MIMORAG_DB_PORT=5433
POSTGRES_DB=mimorag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser

# --- Database roles (created by docker/postgres/initdb on first start) ---
# Owner: runs Flyway migrations. App: runtime DML only, no DDL, no RLS bypass.
MIMORAG_DB_OWNER_PASSWORD=change-me-owner
MIMORAG_DB_APP_PASSWORD=change-me-app

# --- Application ---
MIMORAG_DB_URL=jdbc:postgresql://localhost:5433/mimorag
MIMORAG_DB_POOL_SIZE=10
